{
  "name": "meridian",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fonts": "node scripts/fetch-fonts.mjs",
    "predev": "node scripts/fetch-fonts.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-fonts.mjs",
    "build": "tsc -b && vite build --configLoader native && node scripts/check-dist-no-demo.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "boardui:drift": "node scripts/boardui-drift.mjs",
    "lint:rules": "node --test scripts/eslint-rules.test.mjs scripts/model-contract-rules.test.mjs scripts/check-rust-invented-default.test.mjs scripts/fetch-fonts.test.mjs scripts/build-ime-android.test.mjs",
    "test": "vitest run --configLoader native --pool threads",
    "test:watch": "vitest --configLoader native --pool threads",
    "test:coverage": "vitest run --configLoader native --pool threads --coverage",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots=all",
    "doctor": "react-doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema": "vite --open /#playground/schema",
    "schema:check": "node scripts/check-db-schema.mjs",
    "schema:check:staged": "node scripts/check-db-schema.mjs --staged",
    "catalog:check": "node scripts/check-provider-catalog.mjs",
    "tauri:versions": "node scripts/check-tauri-versions.mjs",
    "catalog:check:staged": "node scripts/check-provider-catalog.mjs --staged",
    "responses:generate": "node scripts/generate-invoke-response-schema.mjs",
    "responses:check": "node scripts/generate-invoke-response-schema.mjs --check",
    "contracts:check": "node scripts/check-model-contracts.mjs",
    "contracts:check:staged": "node scripts/check-model-contracts.mjs --staged",
    "check:dist-no-demo": "node scripts/check-dist-no-demo.mjs",
    "ime:build": "cargo build --release --manifest-path src-tauri/Cargo.toml --target-dir src-tauri/target/ime -p meridian-ime-tsf -p meridian-ime-host && cargo build --release --manifest-path src-tauri/Cargo.toml --target-dir src-tauri/target/ime -p meridian-ime-tsf --target i686-pc-windows-msvc && node -e \"const fs=require('fs'),p='src-tauri/resources/ime.stamp';fs.mkdirSync('src-tauri/resources',{recursive:true});fs.closeSync(fs.openSync(p,'a'));fs.utimesSync(p,new Date(),new Date())\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(*.ts|*.tsx)": [
      "prettier --write --ignore-unknown"
    ]
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "AGPL-3.0-or-later",
  "author": "于小丘 Yuerchu <admin@yuxiaoqiu.cn>",
  "packageManager": "pnpm@10.18.2",
  "pnpm": {
    "overrides": {
      "brace-expansion": "^5.0.8"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "react-doctor": "0.9.11",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@keyline-icons/react": "^1.2.0",
    "@lobehub/icons": "^5.18.0",
    "@number-flow/react": "^0.6.2",
    "@react-aria/utils": "^3.34.1",
    "@react-stately/utils": "^3.12.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-notification": "~2.4.0",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "@xyflow/react": "^12.11.6",
    "diff": "^9.0.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "immer": "^11.1.18",
    "maplibre-gl": "^6.10.0",
    "marked": "^18.0.13",
    "material-icon-theme": "^5.38.1",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "^3.10.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "zustand": "^5.0.15"
  }
}
