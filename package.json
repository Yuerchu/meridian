{
  "name": "meridian",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --configLoader native",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "lint:rules": "node --test scripts/eslint-rules.test.mjs scripts/model-contract-rules.test.mjs",
    "test": "vitest run --configLoader native --pool threads",
    "test:watch": "vitest --configLoader native --pool threads",
    "test:coverage": "vitest run --configLoader native --pool threads --coverage",
    "doctor": "react-doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema": "vite --open /#playground/schema",
    "schema:check": "node scripts/check-db-schema.mjs",
    "schema:check:staged": "node scripts/check-db-schema.mjs --staged",
    "catalog:check": "node scripts/check-provider-catalog.mjs",
    "catalog:check:staged": "node scripts/check-provider-catalog.mjs --staged",
    "responses:generate": "node scripts/generate-invoke-response-schema.mjs",
    "responses:check": "node scripts/generate-invoke-response-schema.mjs --check",
    "contracts:check": "node scripts/check-model-contracts.mjs",
    "contracts:check:staged": "node scripts/check-model-contracts.mjs --staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,html}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "LicenseRef-Proprietary-Yuerchu",
  "author": "于小丘 Yuerchu <admin@yuxiaoqiu.cn>",
  "packageManager": "pnpm@10.18.2",
  "pnpm": {
    "overrides": {
      "brace-expansion": "^5.0.8"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "react-doctor": "0.9.11",
    "shadcn": "^4.17.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@gravity-ui/icons": "^2.21.0",
    "@heroui-pro/react": "1.0.0-beta.8",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@lobehub/icons": "^5.16.0",
    "@number-flow/react": "^0.6.2",
    "@react-aria/utils": "^3.34.1",
    "@react-stately/utils": "^3.12.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "~2.3.3",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tiptap/core": "^3.30.0",
    "@tiptap/extension-link": "^3.30.0",
    "@tiptap/extension-underline": "^3.30.0",
    "@tiptap/extensions": "^3.30.0",
    "@tiptap/pm": "^3.30.0",
    "@tiptap/react": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "@tiptap/suggestion": "^3.30.0",
    "@xyflow/react": "^12.11.3",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "immer": "^11.1.16",
    "maplibre-gl": "^6.3.0",
    "marked": "^18.0.9",
    "material-icon-theme": "^5.37.0",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.10.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  }
}
