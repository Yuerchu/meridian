{
  "$schema": "https://raw.githubusercontent.com/nicr9/schemas/master/schemas/tauri/2/tauri.conf.schema.json",
  "productName": "Meridian",
  "version": "0.2.0",
  "identifier": "cn.yuxiaoqiu.meridian",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Meridian",
        "width": 960,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": true,
        "center": true,
        "backgroundColor": "#0a0a0a",
        "visible": false
      },
      {
        "label": "splashscreen",
        "url": "splash.html",
        "width": 320,
        "height": 320,
        "decorations": false,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "backgroundColor": "#1c2230"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/files/**"]
      }
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../NOTICE": "./"
    },
    "active": true
  },
  "plugins": {}
}
