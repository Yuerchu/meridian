pnpm exec lint-staged

# lint-staged 按文件派发,而 cargo fmt 以 crate 为单位;暂存里有 Rust 改动
# 就整体查一遍(增量编译缓存下不到一秒)。
if git diff --cached --name-only | grep -q '^src-tauri/.*\.rs$'; then
  cargo fmt --all --manifest-path src-tauri/Cargo.toml --check
fi

# 指针指到的 core 提交必须已经在 meridian-core 的远端上。CI 从 GitHub 拉子模块，一个只在
# 本地的提交让每个 job 在 checkout 时就死：2026-10-05 PR 98 指到了 rebase 出来、没推过的
# 提交，三个 job 10 秒内全红。下面的检查看不出这个——staged-snapshot 读的是本地对象库。
# 不 fetch：从这个克隆 push 过的提交，远端跟踪分支就已经包含它，离线也能过。
if git diff --cached --name-only | grep -qE '^src-tauri/crates$'; then
  pinned=$(git ls-files --stage src-tauri/crates | awk '{print $2}')
  if [ -z "$(git -C src-tauri/crates branch -r --contains "$pinned" 2>/dev/null)" ]; then
    echo "✗ src-tauri/crates 指向 ${pinned}，它不在 meridian-core 的任何远端分支上；先在子模块里 push" >&2
    exit 1
  fi
fi

# 动了 schema 就核一遍 src/dev/schema-data.ts:那份数据一半是说明文字,只能人写;
# 另一半是纯结构,一旦和库对不上,那张图就开始很有说服力地骗人。现行 schema 读的是
# core 里的 schema.snapshot.sql（SeaORM 基线建出来的库导出的 DDL），不再重放迁移。
#
# --staged:校验的是**将要提交的东西**。读工作树的话,暂存了 core 指针、却把 schema-data.ts
# 的改动留在工作区没暂存,这里会通过,而提交进去的两半对不上。
#
# src-tauri/crates 是 meridian-core 子模块:core 的文件不会出现在外层的暂存列表里,
# 出现的只有那个 gitlink 本身(`src-tauri/crates`,指针动了才有)。所以下面三处
# 都把它算作触发条件——指针一动,快照/目录/合约都可能跟着变,三个检查一起跑
# 也就几秒。脚本读子模块内容走的是外层暂存的那个 commit(scripts/staged-snapshot.mjs)。
if git diff --cached --name-only | grep -qE '^src-tauri/crates$|^src/dev/schema-data\.ts$|^scripts/(check-db-schema|model-contract-rules|staged-snapshot)\.mjs$'; then
  node scripts/check-db-schema.mjs --staged
fi

# 厂商目录同理:它只描述展示与预填,却会以很有把握的样子出错——写着某家走
# responses,而 adapter 根本不认那个 provider_type,建出来的行发不出请求。
# registry / capabilities 那两侧改了也要核,因为对不上可能是它们动了而目录没跟。
# api_format 的取值来自 registry 的枚举,默认值来自 schema 快照,都在子模块里。
if git diff --cached --name-only | grep -qE '^src-tauri/crates$|^scripts/(check-provider-catalog|model-contract-rules|staged-snapshot)\.mjs$'; then
  node scripts/check-provider-catalog.mjs --staged
fi

# 模型层的红线：持久化/DTO 命名分层、first-party 请求拒绝未知字段、
# 金额全程 Decimal 字符串、invoke response 的生成式 runtime exact schema，
# 以及 SeaORM 实体的归属与列类型（CLAUDE.md「Hard model and protocol standards」）。
# 任何一侧改动都检查暂存快照，避免靠未暂存文件通过；生成器和它依赖的
# syntax helper 自己变化也必须触发 freshness check。
if git diff --cached --name-only | grep -qE '^src/.*\.(ts|tsx)$|^src-tauri/crates$|^src-tauri/.*\.(rs|sql|json)$|^src-tauri/(Cargo\.toml|Cargo\.lock)$|^scripts/(check-model-contracts|generate-invoke-response-schema|model-contract-rules(\.test)?|transaction-graph-lib|staged-snapshot)\.mjs$'; then
  node scripts/check-model-contracts.mjs --staged
fi

# 事务调用图：Diesel 与 SeaORM 共存期间，一个事务必须整个落在一个连接池上；
# Diesel 事务里不能再碰到另一个 immediate_transaction。docs/transaction-graph.md
# 是它生成的分期依据，过期也算失败（node scripts/check-transaction-graph.mjs --write）；
# docs/migration-counters.json 是只减不增的基线，docs/dual-impl.md 是双实现登记表。
if git diff --cached --name-only | grep -qE '^src-tauri/.*\.rs$|^src-tauri/crates$|^scripts/(check-transaction-graph|transaction-graph-lib|staged-snapshot)\.mjs$|^docs/(transaction-graph\.md|migration-counters\.json|dual-impl\.md)$'; then
  node scripts/check-transaction-graph.mjs --staged
fi

# core 的生产代码里不许 block_on：同步到异步只在壳的 setup 和 meridiand 的 main
# 各跨一次，core 跑在别人的 runtime 里，在那里 block_on 会 panic 或堵死线程。
if git diff --cached --name-only | grep -qE '^src-tauri/crates$|^scripts/(check-core-block-on|check-transaction-graph|transaction-graph-lib|staged-snapshot)\.mjs$'; then
  node scripts/check-core-block-on.mjs --staged
fi

# 壳层引用了 core 在 Android 上编译掉的东西、自己却没有 cfg：桌面编译永远编不到
# 那一行，本地全绿，只有 CI 的 Android 检查会红——sandbox、onebot、services.acp
# 三次都是这样。只读文本，几秒；本机跑 Android 编译太重，这是能前移的那一半。
if git diff --cached --name-only | grep -qE '^src-tauri/src/.*\.rs$|^src-tauri/crates$|^scripts/(check-android-cfg|android-cfg-lib|staged-snapshot)\.mjs$'; then
  node scripts/check-android-cfg.mjs --staged
fi

# 一个描述模型、厂商或配置上限的值，没配就是 None，不许编一个数顶上（no-invented-domain-default
# 的 Rust 半边）。原来只在 CI 跑：2026-10-07 壳 PR 114 本地全绿、推上去 Linux CI 红在这一步。
# 读暂存快照，core 读外层将要指向的那个 commit，和上面几项一致。
if git diff --cached --name-only | grep -qE '^src-tauri/crates$|^scripts/(check-rust-invented-default|staged-snapshot)\.mjs$|^scripts/eslint-rules/domain-vocabulary\.mjs$'; then
  node scripts/check-rust-invented-default.mjs --staged src-tauri/crates/core/src
fi
if git diff --cached --name-only | grep -qE '^src-tauri/src/.*\.rs$|^scripts/(check-rust-invented-default|staged-snapshot)\.mjs$|^scripts/eslint-rules/domain-vocabulary\.mjs$'; then
  node scripts/check-rust-invented-default.mjs --staged
fi

# Tauri CLI 要求 npm 包和对应 Rust crate 的主/次版本一致，否则 `tauri dev` /
# `tauri build` 直接拒绝；CI 里没有任何一步跑 Tauri CLI，所以只能靠这里和
# frontend-build 里的同一个脚本。只读两份 lock，不需要安装或编译。
if git diff --cached --name-only | grep -qE '^(package\.json|pnpm-lock\.yaml|src-tauri/Cargo\.(toml|lock))$'; then
  node scripts/check-tauri-versions.mjs
fi

# GitHub Actions 的 workflow 在推上去之前没有任何东西会执行它，写错了要等到
# 触发那一刻才知道——发版流程一年跑几次，错一次就是一次发版。actionlint 检查
# 语法、表达式和上下文属性；读的是暂存区的版本，和上面几项一样。
# 它查不出语义上的坑：`inputs.android != false` 在 tag push 时 inputs 为空，
# null 与 false 都被转成 0，结果为假，Android 构建因此被跳过了两个版本。
if git diff --cached --name-only | grep -qE '^\.github/workflows/.*\.ya?ml$'; then
  if ! command -v actionlint >/dev/null 2>&1; then
    echo "actionlint 未安装:winget install rhysd.actionlint(其他平台见 https://github.com/rhysd/actionlint)" >&2
    exit 1
  fi
  for f in $(git diff --cached --name-only --diff-filter=ACMR | grep -E '^\.github/workflows/.*\.ya?ml$'); do
    git show ":$f" | actionlint -stdin-filename "$f" - || exit 1
  done
fi
