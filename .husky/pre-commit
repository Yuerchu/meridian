pnpm exec lint-staged

# lint-staged 按文件派发,而 cargo fmt 以 crate 为单位;暂存里有 Rust 改动
# 就整体查一遍(增量编译缓存下不到一秒)。
if git diff --cached --name-only | grep -q '^src-tauri/.*\.rs$'; then
  cargo fmt --all --manifest-path src-tauri/Cargo.toml --check
fi

# 动了迁移就核一遍 src/dev/schema-data.ts:那份数据一半是说明文字,只能人写;
# 另一半是纯结构,一旦和迁移对不上,那张图就开始很有说服力地骗人。
#
# --staged:校验的是**将要提交的东西**。读工作树的话,暂存了迁移、却把 schema-data.ts
# 的改动留在工作区没暂存,这里会通过,而提交进去的两半对不上。
if git diff --cached --name-only | grep -qE '^src-tauri/crates/core/migrations/|^src/dev/schema-data\.ts$'; then
  node scripts/check-db-schema.mjs --staged
fi

# 厂商目录同理:它只描述展示与预填,却会以很有把握的样子出错——写着某家走
# responses,而 adapter 根本不认那个 provider_type,建出来的行发不出请求。
# registry / capabilities 那两侧改了也要核,因为对不上可能是它们动了而目录没跟。
if git diff --cached --name-only | grep -qE '^src-tauri/crates/core/src/provider/(provider_catalog\.json|registry\.rs|capabilities\.rs|model_catalog\.json)$'; then
  node scripts/check-provider-catalog.mjs --staged
fi
