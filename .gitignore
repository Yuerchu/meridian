node_modules/
dist/
# A cargo invocation made from the repository root lands here rather than in
# src-tauri/target. Same build output, different path.
/target/
src-tauri/target/
src-tauri/.cargo/
# Runtime DLLs that build.rs stages out of target/<profile>, so the bundle
# config can name them without knowing which profile is being built.
src-tauri/resources/
src-tauri/*_dev.db
*.apk
*.idsig
*.jks
*.keystore
build_release_apk.ps1
icon.png
*.log
.DS_Store
tsconfig.tsbuildinfo
# .claude/ is per machine (skills, local settings, worktrees) except the rules,
# which are the design record split out of CLAUDE.md
.claude/*
!.claude/rules/
.codex/
.mcp.json
temp/

# Playwright MCP scratch output (page snapshots, console logs, screenshots)
.playwright-mcp/

# Remote agent attachment cache
.codex-remote-attachments/

.cache/litert-runtime/
.cache/scripts/

# Playwright visual regression: run output and the HTML report. The baselines
# under e2e/__screenshots__/ are committed.
/test-results/
/playwright-report/
/blob-report/
